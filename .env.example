NEXT_PUBLIC_SITE_URL=https://tu-dominio.com

# Backend de solicitudes. Usa "json" solamente en desarrollo o "postgres".
IRP_REPOSITORY_DRIVER=json
IRP_JSON_DATA_PATH=
IRP_CONTROL_JSON_DATA_PATH=
IRP_COMPLAINT_JSON_DATA_PATH=
DATABASE_URL=
IRP_BUSINESS_TIME_ZONE=America/Lima

# Analítica opcional. No se carga hasta que el usuario dé consentimiento.
NEXT_PUBLIC_ANALYTICS_ID=

# Acceso a /admin. No existen credenciales ni secretos predeterminados.
IRP_ADMIN_EMAIL=
IRP_ADMIN_PASSWORD_HASH=
IRP_ADMIN_ROLE=
IRP_AUTH_SECRET=

# Opcionales: credenciales de una cuenta QA para los chequeos automatizados del panel.
IRP_QA_EMAIL=
IRP_QA_PASSWORD=

# Servidor standalone (VPS/contenedor).
HOSTNAME=0.0.0.0
PORT=3000
